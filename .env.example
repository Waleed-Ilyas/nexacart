# Copy to .env at the repository root for local development. See README for where to get each value (all free tiers).
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (free M0)
MONGODB_URI=
# Any random string of 32+ characters, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Stripe, test mode keys only (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (free)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: make the demo admin read-only for product changes (used on the public demo)
DEMO_ADMIN_READONLY=false
